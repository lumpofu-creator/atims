{
    "openapi": "3.0.3",
    "info": {
        "title": "ATIMS Backend API",
        "description": "Asset Tracking and Inventory Management System API Documentation. This API provides endpoints for managing assets, inspections, incidents, task queues, and more.",
        "version": "1.0.0",
        "contact": {
            "name": "ATIMS Support",
            "email": "support@atims.local"
        }
    },
    "servers": [
        {
            "url": "http://localhost/atims-be",
            "description": "Development server"
        },
        {
            "url": "https://api.atims.local",
            "description": "Production server"
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "summary": "Health Check",
                "description": "Check API health status and database connection",
                "tags": ["System"],
                "responses": {
                    "200": {
                        "description": "API is healthy",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": { "type": "string", "example": "healthy" },
                                        "database": { "type": "string", "example": "connected" },
                                        "timestamp": { "type": "string", "format": "date-time", "example": "2024-01-15 10:30:00" },
                                        "version": { "type": "string", "example": "1.0.0" }
                                    }
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Service unavailable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": false },
                                        "error": { "type": "string", "example": "Service unhealthy" },
                                        "details": { "type": "object" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "summary": "User Login",
                "description": "Authenticate user and return JWT token",
                "tags": ["Authentication"],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["username", "password"],
                                "properties": {
                                    "username": { "type": "string", "example": "admin_logistics" },
                                    "password": { "type": "string", "format": "password", "example": "password123" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": true },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
                                                "expires_at": { "type": "string", "format": "date-time", "example": "2024-01-15 11:30:00" },
                                                "user": {
                                                    "type": "object",
                                                    "properties": {
                                                        "id": { "type": "integer", "example": 1 },
                                                        "username": { "type": "string", "example": "admin_logistics" },
                                                        "email": { "type": "string", "example": "admin.logistics@example.com" },
                                                        "role": { "type": "string", "example": "Logistics Officer" }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": false },
                                        "error": { "type": "string", "example": "Invalid credentials" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "summary": "User Registration",
                "description": "Register a new user",
                "tags": ["Authentication"],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["username", "email", "password", "role"],
                                "properties": {
                                    "username": { "type": "string", "example": "new_user" },
                                    "email": { "type": "string", "format": "email", "example": "new.user@example.com" },
                                    "password": { "type": "string", "format": "password", "example": "password123" },
                                    "first_name": { "type": "string", "example": "John" },
                                    "last_name": { "type": "string", "example": "Doe" },
                                    "role": { "type": "string", "enum": ["Logistics Officer", "Field Agent", "State Auditor", "Executive"], "example": "Field Agent" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": true },
                                        "message": { "type": "string", "example": "User registered successfully" },
                                        "id": { "type": "integer", "example": 5 }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": false },
                                        "error": { "type": "string", "example": "Validation failed" },
                                        "details": { "type": "object" }
                                    }
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "User already exists",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": false },
                                        "error": { "type": "string", "example": "Username or email already exists" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/profile": {
            "get": {
                "summary": "Get User Profile",
                "description": "Retrieve authenticated user's profile information",
                "tags": ["Authentication"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Profile retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": true },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": { "type": "integer", "example": 1 },
                                                "username": { "type": "string", "example": "admin_logistics" },
                                                "email": { "type": "string", "example": "admin.logistics@example.com" },
                                                "first_name": { "type": "string", "example": "Logistics" },
                                                "last_name": { "type": "string", "example": "Admin" },
                                                "phone": { "type": "string", "example": "+33 1 23 45 67 89" },
                                                "role": { "type": "string", "example": "Logistics Officer" },
                                                "mfa_enabled": { "type": "boolean", "example": false }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": false },
                                        "error": { "type": "string", "example": "Unauthorized" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/assets": {
            "get": {
                "summary": "List All Assets",
                "description": "Retrieve paginated list of all assets with filtering",
                "tags": ["Assets"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": { "type": "integer", "default": 1 }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": { "type": "integer", "default": 20 }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["Fonctionnel", "En Panne", "Déclassé", "Inconnu"] }
                    },
                    {
                        "name": "category_id",
                        "in": "query",
                        "schema": { "type": "integer" }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Assets retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": true },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "items": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "id": { "type": "integer", "example": 1 },
                                                            "state_id": { "type": "string", "example": "FLEET-000001" },
                                                            "name": { "type": "string", "example": "Toyota Camry Sedan" },
                                                            "description": { "type": "string", "example": "Fleet vehicle for administrative transport" },
                                                            "category_id": { "type": "integer", "example": 9 },
                                                            "registered_location": { "type": "string", "example": "Ministry of Finance, 123 Central Avenue, Paris" },
                                                            "latitude": { "type": "number", "format": "decimal", "example": 48.8566 },
                                                            "longitude": { "type": "number", "format": "decimal", "example": 2.3522 },
                                                            "acquisition_date": { "type": "string", "format": "date", "example": "2022-03-15" },
                                                            "purchase_value": { "type": "number", "format": "decimal", "example": 35000.00 },
                                                            "current_value": { "type": "number", "format": "decimal", "example": 30000.00 },
                                                            "current_status": { "type": "string", "example": "Fonctionnel" },
                                                            "created_at": { "type": "string", "format": "date-time", "example": "2024-01-10 10:00:00" }
                                                        }
                                                    }
                                                },
                                                "pagination": {
                                                    "type": "object",
                                                    "properties": {
                                                        "total": { "type": "integer", "example": 150 },
                                                        "page": { "type": "integer", "example": 1 },
                                                        "limit": { "type": "integer", "example": 20 },
                                                        "total_pages": { "type": "integer", "example": 8 }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            },
            "post": {
                "summary": "Create New Asset",
                "description": "Create a new asset in the system",
                "tags": ["Assets"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["name", "category_id", "latitude", "longitude", "current_status"],
                                "properties": {
                                    "name": { "type": "string", "example": "Honda CR-V SUV" },
                                    "description": { "type": "string", "example": "SUV for field operations" },
                                    "category_id": { "type": "integer", "example": 10 },
                                    "state_id": { "type": "string", "example": "FLEET-000003" },
                                    "registered_location": { "type": "string", "example": "Regional Office, Marseille" },
                                    "latitude": { "type": "number", "format": "decimal", "example": 43.2965 },
                                    "longitude": { "type": "number", "format": "decimal", "example": 5.3698 },
                                    "acquisition_date": { "type": "string", "format": "date", "example": "2024-01-15" },
                                    "purchase_value": { "type": "number", "format": "decimal", "example": 42000.00 },
                                    "current_value": { "type": "number", "format": "decimal", "example": 42000.00 },
                                    "current_status": { "type": "string", "enum": ["Fonctionnel", "En Panne", "Déclassé", "Inconnu"], "example": "Fonctionnel" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Asset created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": true },
                                        "message": { "type": "string", "example": "Asset created successfully" },
                                        "id": { "type": "integer", "example": 5 }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/assets/{id}": {
            "get": {
                "summary": "Get Asset by ID",
                "description": "Retrieve detailed information about a specific asset",
                "tags": ["Assets"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "integer", "example": 1 }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Asset retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": { "type": "boolean", "example": true },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": { "type": "integer", "example": 1 },
                                                "state_id": { "type": "string", "example": "FLEET-000001" },
                                                "name": { "type": "string", "example": "Toyota Camry Sedan" },
                                                "description": { "type": "string", "example": "Fleet vehicle for administrative transport" },
                                                "category_id": { "type": "integer", "example": 9 },
                                                "registered_location": { "type": "string", "example": "Ministry of Finance, 123 Central Avenue, Paris" },
                                                "latitude": { "type": "number", "format": "decimal", "example": 48.8566 },
                                                "longitude": { "type": "number", "format": "decimal", "example": 2.3522 },
                                                "location_point": { "type": "string", "example": "POINT(2.3522 48.8566)" },
                                                "acquisition_date": { "type": "string", "format": "date", "example": "2022-03-15" },
                                                "purchase_value": { "type": "number", "format": "decimal", "example": 35000.00 },
                                                "current_value": { "type": "number", "format": "decimal", "example": 30000.00 },
                                                "current_status": { "type": "string", "example": "Fonctionnel" },
                                                "created_by": { "type": "integer", "example": 1 },
                                                "created_at": { "type": "string", "format": "date-time", "example": "2024-01-10 10:00:00" },
                                                "updated_at": { "type": "string", "format": "date-time", "example": "2024-01-12 15:30:00" }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Asset not found"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            },
            "put": {
                "summary": "Update Asset",
                "description": "Update an existing asset",
                "tags": ["Assets"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "integer", "example": 1 }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "description": { "type": "string" },
                                    "category_id": { "type": "integer" },
                                    "registered_location": { "type": "string" },
                                    "latitude": { "type": "number", "format": "decimal" },
                                    "longitude": { "type": "number", "format": "decimal" },
                                    "acquisition_date": { "type": "string", "format": "date" },
                                    "purchase_value": { "type": "number", "format": "decimal" },
                                    "current_value": { "type": "number", "format": "decimal" },
                                    "current_status": { "type": "string", "enum": ["Fonctionnel", "En Panne", "Déclassé", "Inconnu"] }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Asset updated successfully"
                    },
                    "404": {
                        "description": "Asset not found"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            },
            "delete": {
                "summary": "Delete Asset",
                "description": "Delete an asset from the system",
                "tags": ["Assets"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "integer", "example": 1 }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Asset deleted successfully"
                    },
                    "404": {
                        "description": "Asset not found"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/assets/search": {
            "get": {
                "summary": "Search Assets",
                "description": "Search assets by keyword or state ID",
                "tags": ["Assets"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": true,
                        "schema": { "type": "string", "example": "FLEET-000001" }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": { "type": "integer", "default": 20 }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Search results"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/assets/category/{categoryId}": {
            "get": {
                "summary": "Get Assets by Category",
                "description": "Retrieve all assets in a specific category",
                "tags": ["Assets"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "categoryId",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "integer", "example": 9 }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Assets in category"
                    },
                    "404": {
                        "description": "Category not found"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/inspections": {
            "get": {
                "summary": "List All Inspections",
                "description": "Retrieve paginated list of inspections",
                "tags": ["Inspections"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": { "type": "integer", "default": 1 }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": { "type": "integer", "default": 20 }
                    },
                    {
                        "name": "asset_id",
                        "in": "query",
                        "schema": { "type": "integer" }
                    },
                    {
                        "name": "user_id",
                        "in": "query",
                        "schema": { "type": "integer" }
                    },
                    {
                        "name": "type",
                        "in": "query",
                        "schema": { "type": "string", "enum": ["Routine", "Breakdown", "Maintenance", "Handover"] }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Inspections retrieved"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            },
            "post": {
                "summary": "Create Inspection",
                "description": "Record a new inspection for an asset",
                "tags": ["Inspections"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["asset_id", "inspection_type", "condition_status"],
                                "properties": {
                                    "asset_id": { "type": "integer", "example": 1 },
                                    "inspection_type": { "type": "string", "enum": ["Routine", "Breakdown", "Maintenance", "Handover"], "example": "Routine" },
                                    "condition_status": { "type": "string", "enum": ["Fonctionnel", "En Panne", "Déclassé", "Inconnu"], "example": "Fonctionnel" },
                                    "field_notes": { "type": "string", "example": "Regular inspection completed. Vehicle in good condition." },
                                    "device_latitude": { "type": "number", "format": "decimal", "example": 48.8567 },
                                    "device_longitude": { "type": "number", "format": "decimal", "example": 2.3523 },
                                    "device_gps_accuracy": { "type": "number", "format": "decimal", "example": 5.2 },
                                    "device_timestamp": { "type": "string", "format": "date-time", "example": "2024-01-10 10:30:00" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Inspection created"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/incidents/log": {
            "post": {
                "summary": "Log Incident",
                "description": "Report a new incident for an asset",
                "tags": ["Incidents"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": ["asset_id", "incident_type", "description"],
                                "properties": {
                                    "asset_id": { "type": "integer", "example": 2 },
                                    "incident_type": { "type": "string", "enum": ["Breakdown", "Damage", "Theft", "Other"], "example": "Breakdown" },
                                    "description": { "type": "string", "example": "Engine failure - vehicle non-operational" },
                                    "location": { "type": "string", "example": "Highway A7, Southbound" },
                                    "latitude": { "type": "number", "format": "decimal", "example": 45.7642 },
                                    "longitude": { "type": "number", "format": "decimal", "example": 4.8359 },
                                    "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"], "example": "High" },
                                    "photos": { "type": "array", "items": { "type": "string" }, "description": "Base64 encoded images" }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Incident logged"
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/incidents/unresolved": {
            "get": {
                "summary": "Get Unresolved Incidents",
                "description": "Retrieve all unresolved incidents",
                "tags": ["Incidents"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Unresolved incidents retrieved"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/dashboards/kpi": {
            "get": {
                "summary": "Get Dashboard KPIs",
                "description": "Retrieve key performance indicators for the dashboard",
                "tags": ["Dashboard"],
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "KPIs retrieved"
