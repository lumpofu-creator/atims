# ATIMS Environment Configuration

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=atims
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-use-a-strong-random-key
JWT_ALGORITHM=HS256

# Session
SESSION_TIMEOUT=1800
SESSION_COOKIE_NAME=atims_session

# Logging
LOG_LEVEL=debug

# File Uploads
MAX_UPLOAD_SIZE=8M

# Geofencing
GEO Fence_THRESHOLD_KM=2.0
GPS_ACCURACY_THRESHOLD_M=15

# QR Code
QR_SIZE=256

# External Services (Optional)
# Twilio for SMS OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@atims.local

# Redis (Production)
REDIS_HOST=localhost
REDIS_PORT=6379

# Map Services
OPENSTREETMAP_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
